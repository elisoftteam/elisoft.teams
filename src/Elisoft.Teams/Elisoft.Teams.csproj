<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>Elisoft.Teams</PackageId>
        <Version>1.0.0</Version>
        <Authors>Elisoft Team</Authors>
        <Company>Elisoft</Company>
        <Description>A lightweight and simple library for sending notifications to Teams in .NET applications.</Description>
        <PackageTags>teams;notification;webhook;alert;net9</PackageTags>
        <RepositoryUrl>https://github.com/elisoftteam/elisoft.teams</RepositoryUrl>
        <PackageProjectUrl>https://github.com/elisoftteam/elisoft.teams</PackageProjectUrl>
        <RepositoryType>git</RepositoryType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Services\" />
    </ItemGroup>
    

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>    
</Project>
